<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_card"
    android:padding="12dp"
    tools:ignore="UseSwitchCompatOrMaterialXml"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:gravity="center_horizontal"
        android:text="@string/option_edit_controls"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="4dp"
                style="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorPrimary"
                android:text="@string/option_edit_controls"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/customctrl_addbutton"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_drawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/customctrl_addbutton_drawer"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_joystick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/customctrl_addbutton_joystick"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="4dp"
                style="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorPrimary"
                android:text="@string/generic_save"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="@string/generic_load"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:text="@string/generic_save"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_and_exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button"
                android:text="@string/global_save_and_exit"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_and_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="@string/customctrl_export"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingHorizontal="4dp"
                style="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorPrimary"
                android:text="@string/pedit_control"/>

            <RelativeLayout
                android:id="@+id/snapping_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/background_item"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/snapping_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/snapping"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/controls_settings_button_snapping"/>

                <Switch
                    android:id="@+id/snapping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/snapping_distance_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/controls_settings_button_snapping_distance"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/snapping_distance_remove"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_horizontal"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:textColor="?attr/colorOnSurface"
                        android:text="-"
                        android:textSize="20sp"
                        tools:ignore="HardcodedText"/>

                    <SeekBar
                        android:id="@+id/snapping_distance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/snapping_distance_remove"
                        android:layout_toStartOf="@id/snapping_distance_add"
                        android:max="30"/>

                    <TextView
                        android:id="@+id/snapping_distance_add"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/snapping_distance_value"
                        android:gravity="center_horizontal"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:textColor="?attr/colorOnSurface"
                        android:text="+"
                        android:textSize="20sp"
                        tools:ignore="HardcodedText"/>

                    <TextView
                        android:id="@+id/snapping_distance_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/background_text"
                        android:minWidth="40dp"
                        android:gravity="center"
                        style="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="0"/>
                </RelativeLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/select_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="@string/customctrl_selectdefault"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:text="@string/customctrl_editor_exit"
                android:textColor="?attr/colorError"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="12dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>