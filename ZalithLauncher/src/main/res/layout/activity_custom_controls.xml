<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customctrl_drawerlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/background_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <net.kdt.pojavlaunch.customcontrols.ControlLayout
            android:id="@+id/customctrl_controllayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/customctrl_menu_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="12dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/customctrl_menu_open"
            app:fabSize="mini"
            app:tint="?attr/colorOnPrimaryContainer"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:elevation="4dp"/>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/customctrl_navigation_view"
        android:layout_width="272dp"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:layout_gravity="end"
        android:elevation="8dp"
        android:translationZ="4dp"/>

</androidx.drawerlayout.widget.DrawerLayout>