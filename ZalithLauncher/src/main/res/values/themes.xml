<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.ZalithLauncher" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
        The Legacy (Zalith Launcher 1) control layout editor is always presented in dark mode,
        regardless of the device/system theme or the launcher's own light/dark setting, matching
        the look of the original Zalith Launcher 1 editor. This mirrors the values-night variant
        of AppTheme.ZalithLauncher below, but is not night-mode qualified so it applies always.
    -->
    <style name="AppTheme.ZalithLauncher.LegacyEditor" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="AppTheme.SplashScreen" parent="@style/Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/AppTheme.ZalithLauncher</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_launcher</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>